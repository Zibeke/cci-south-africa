{
  "name": "cci-community-portal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"cross-env PORT=5005 npm run dev -w backend\" \"cross-env PORT=3005 npm start -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3"
  }
}